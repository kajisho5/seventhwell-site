{
  // Cloudflare Workers の設定。サイト本体は dist/ の静的ファイル、/api/* だけ Worker が受ける
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seventhwell-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "vars": {
    // 通知先（Cloudflare で「確認済み宛先」にしたアドレス）と送信元
    "CONTACT_TO": "kajiyama@seventh-well.com",
    "CONTACT_FROM": "form@seventh-well.com",
    // Turnstile のテスト用キー（必ず成功）。本番は Cloudflare 画面で発行した値に差し替え
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  },
  // TURNSTILE_SECRET は `wrangler secret put TURNSTILE_SECRET` で登録（ここには書かない）
  "send_email": [
    { "name": "EMAIL", "allowed_destination_addresses": ["kajiyama@seventh-well.com"] }
  ],
  "ratelimits": [
    { "name": "CONTACT_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
