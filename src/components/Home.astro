---
import Base from "../layouts/Base.astro";
import SiteHeader from "./SiteHeader.astro";
import HeroStage from "./HeroStage.astro";
import Platform from "./Platform.astro";
import Services from "./Services.astro";
import Works from "./Works.astro";
import OpenSource from "./OpenSource.astro";
import Contact from "./Contact.astro";
import SiteFooter from "./SiteFooter.astro";
import type { Lang } from "../data/site";
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Base lang={lang} path={lang === "ja" ? "/" : "/en/"}>
  <SiteHeader lang={lang} />
  <main id="main">
    <HeroStage lang={lang} />
    <Platform lang={lang} />
    <Services lang={lang} />
    <Works lang={lang} />
    <OpenSource lang={lang} />
    <Contact lang={lang} />
  </main>
  <SiteFooter lang={lang} />
</Base>
