---
import Icon from "./Icon.astro";
import { t, type Lang } from "../data/site";
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = t[lang];
// Turnstile のサイトキー（公開してよい値）。未設定ならテスト用キー
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "1x00000000000000000000AA";
---
<section id="contact">
  <div class="cta-band">
    <div class="wrap">
      <div class="cta-in">
        <div>
          <h2>{T.closeTitle}</h2>
          <p>{T.closeLead}</p>
          <a class="btn btn-primary btn-lg" href="#contact-form" data-topic="work">{T.consult} →</a>
        </div>
        <div class="cta-shot" aria-hidden="true">
          <div class="win-bar"><i></i><i></i><i></i><span class="mono">STREAMTALLY</span></div>
          <div class="cta-rows">
            {(lang === "ja" ? [["メイン配信", "SRT · 6.0 Mbps"], ["予備配信", "RTMP · 4.5 Mbps"], ["会場収録", "ProRes 422"], ["サブ会場", "HLS · 3.2 Mbps"]] : [["Main stream", "SRT · 6.0 Mbps"], ["Backup", "RTMP · 4.5 Mbps"], ["Recording", "ProRes 422"], ["Room B", "HLS · 3.2 Mbps"]]).map(([a, b], k) => (
              <div><span>{a}<small class="mono">{b}</small></span><span class="st on">LIVE</span><span class="cta-bars">{Array.from({ length: 12 }, (_, j) => <i style={`--t:${0.5 + ((j * 7 + k) % 5) * 0.12}s`}></i>)}</span></div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="wrap">
    <form id="contact-form" class="form-card" data-contact data-ok={T.fOk} data-ng={T.fNg} data-sending={T.fSending} novalidate>
      <h3>{T.formTitle}</h3>
      <p>{T.formLead}</p>
      <div class="field">
        <label for="f-name">{T.fName}<span class="req">*</span></label>
        <input class="input" id="f-name" name="name" autocomplete="name" required maxlength="100" />
      </div>
      <div class="field">
        <label for="f-email">{T.fEmail}<span class="req">*</span></label>
        <input class="input" id="f-email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="200" />
      </div>
      <fieldset class="field">
        <legend>{T.fType}<span class="req">*</span></legend>
        <div class="types">
          {T.fTypes.map(([v, label], i) => (
            <label><input type="radio" name="type" value={v} checked={i === 0} /><span>{label}</span></label>
          ))}
        </div>
      </fieldset>
      <div class="field">
        <label for="f-msg">{T.fMsg}<span class="req">*</span></label>
        <textarea class="input" id="f-msg" name="message" required maxlength="4000" placeholder={T.fPlaceholder}></textarea>
        <span class="count" data-count-for="f-msg">0 / 4000</span>
      </div>
      <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <input type="hidden" name="topic" value="" />
      <input type="hidden" name="lang" value={lang} />
      <div class="form-foot">
        <div class="cf-turnstile" data-sitekey={siteKey} data-language={lang} data-theme="auto"></div>
        <button class="btn btn-primary btn-lg" type="submit">{T.fSend}<Icon name="right" size={18} /></button>
      </div>
      <div class="form-msg" role="status" aria-live="polite"></div>
      <p class="form-note">{T.fPrivacy}</p>
    </form>
  </div>
</section>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
